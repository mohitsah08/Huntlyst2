# ==========================================================================
# Environment Variables for Claude Code & Agent Toolkit MCP Servers
# Copy this file to .env or export into your shell before starting Claude
# ==========================================================================

# GitHub MCP Server
# Generate from: https://github.com/settings/tokens (classic with 'repo' scope or fine-grained)
GITHUB_PERSONAL_ACCESS_TOKEN=
GITHUB_TOKEN=

# Supabase MCP Server (optional if using mcp-remote interactive OAuth)
SUPABASE_ACCESS_TOKEN=
SUPABASE_PROJECT_REF=

# Vercel MCP Server (optional if using mcp-remote interactive OAuth)
VERCEL_API_TOKEN=

# Higgsfield AI MCP Server
HIGGSFIELD_API_KEY=

# Google Maps / Places API (used for authoritative entity resolution)
GOOGLE_PLACES_API_KEY=
