# Huntlyst2 + Houston — Environment Variables
# Copy this file to .env.local and configure your environment

# LLM Reasoning Layer
# Anthropic API key for Claude 3.5 Sonnet / Haiku synthesis & extraction
ANTHROPIC_API_KEY=
# Optional fallback LLM providers
OPENAI_API_KEY=
GEMINI_API_KEY=
PERPLEXITY_API_KEY=

# Search & Web Intelligence Layer
# SerpApi Google Organic & News Search (100 free searches/month)
SERPAPI_KEY=
# Brave Search API (optional additional web search provider)
BRAVE_API_KEY=
# Google Places / Maps API (for geographic headquarters validation)
GOOGLE_PLACES_API_KEY=

# Email Verification & Deliverability Layer
# Abstract API for real-time SMTP/MX deliverability checks
ABSTRACT_API_KEY=
# MillionVerifier or Hunter API (optional alternative verification providers)
MILLION_VERIFIER_API_KEY=
HUNTER_API_KEY=

# Houston Agent Runtime & MCP Configuration
# Houston Cloud API Key (Optional — in-process runtime is active by default)
HOUSTON_API_KEY=
# Houston Environment Mode: development | production
HOUSTON_ENV=development
# Houston Workspace path (defaults to .houston/workspaces/huntlyst)
HOUSTON_WORKSPACE_PATH=./.houston/workspaces/huntlyst

# Storage & Persistence
# Disk persistence path for search memory, fingerprints, and sessions
HUNTLYST_DATA_DIR=./.huntlyst/data