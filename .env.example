# Huntlyst — Environment Variables
# Copy this to .env.local and fill in your API keys

# Required: SerpAPI key for Google search (free tier: 100 searches/month)
# Get from: https://serpapi.com/
SERPAPI_KEY=

# Required: Anthropic API key for Claude models
# Get from: https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Optional: Abstract API key for email verification
# Get from: https://www.abstractapi.com/email-verification-validation-api
ABSTRACT_API_KEY=

# Optional: Google Maps / Places API key
GOOGLE_PLACES_API_KEY=